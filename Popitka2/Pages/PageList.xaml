<Page x:Class="Popitka2.Pages.PageList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popitka2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D3D3D3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image Source="/Image/logo.png" Margin="5"/>
        <TextBox x:Name="txbSearch" Grid.Row="0" Grid.Column="1" ToolTip="Введите для поиска" TextChanged="TextBox_TextChanged"/>
        <!--<ComboBox x:Name="cmbSort" Text="сортировка" Grid.Row="0" Grid.Column="2" SelectionChanged="SelChSortObjects"/>-->
        <ComboBox x:Name="cmbSort" ItemsSource="{Binding productTypes}" SelectionChanged="SelChSortObjects" Grid.Row="0" Grid.Column="2">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="cmbFilter" Text="фильтрация" Grid.Row="0" Grid.Column="3" SelectionChanged="SelChFolterObjects"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
            <ListView x:Name="listProd" Margin="5" ItemsSource="{Binding Product}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Image Source="{Binding Image}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock x:Name="txtType" Text="{Binding ProductType.Title}"/>
                                        <TextBlock Text=" | "/>
                                        <TextBlock x:Name="txtTitle" Text="{Binding Title}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="txtArticle" Text="{Binding ArticleNumber}"/>
                                    <TextBlock Text="Материалы: " FontSize="30"/>
                                    <!--<TextBlock x:Name="txtMaterial" Text="{Binding Material.Title}"/>-->
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{Binding MinCostForAgent}"/>
                                    <Button Content="изменить" Click="ClEventEditElement"/>
                                    <Button Content="удалить" Click="ClEventDeleteElement"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
